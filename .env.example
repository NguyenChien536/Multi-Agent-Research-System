# ==============================================================================
# MultiAgent Research System (ATI) - Environment Variables Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_SECRET_KEY=replace-with-a-secure-random-secret-key-32-chars-min
API_V1_STR=/api/v1

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_USER=ati_user
POSTGRES_PASSWORD=ati_secure_password
POSTGRES_DB=ati_research_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://ati_user:ati_secure_password@postgres:5432/ati_research_db

# Redis Configuration (Message Broker & SSE Pub/Sub)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# LLM Providers (Tối thiểu cần có API Key của Tavily và Anthropic hoặc OpenAI)
TAVILY_API_KEY=your_tavily_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Embedding Configuration
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Observability (Tùy chọn)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=ati-multiagent-research

# Rate Limiting & Concurrency Guardrails
MAX_CONCURRENT_TASKS_PER_USER=2
DEFAULT_BUDGET_USD=2.00
DEFAULT_MAX_LLM_CALLS=50
