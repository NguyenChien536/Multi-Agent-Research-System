# ==============================================================================
# Multi-Agent Research System - Environment Variables Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
USE_SERVER_PROVIDERS=false
APP_SECRET_KEY=replace-with-a-secure-random-secret-key-32-chars-min
API_V1_STR=/api/v1

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_USER=research_user
POSTGRES_PASSWORD=research_secure_password
POSTGRES_DB=research_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://research_user:research_secure_password@postgres:5432/research_db

# Redis Configuration (Message Broker & SSE Pub/Sub)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Optional search provider. OpenAlex/Crossref work without a key at modest volume.
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
# Optional comma-separated list for an additional Tavily search restricted to academic domains.
# Example: arxiv.org,aclanthology.org,dl.acm.org,ieeexplore.ieee.org
TAVILY_ACADEMIC_DOMAINS=
# Optional; scholarly search works without API keys at modest volume.
OPENALEX_API_KEY=
CROSSREF_MAILTO=
SCHOLARLY_REQUEST_COST_USD=0.001
SCHOLARLY_SEARCH_TIMEOUT_SECONDS=20
# Leave unused providers empty; placeholder strings are not valid credentials.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Shared per-model pacing. Set this to the quota assigned to your actual key/project.
GEMINI_REQUESTS_PER_MINUTE=12
GEMINI_MAX_QUEUE_SECONDS=90
GROQ_API_KEY=

# Provider Fallback & Priority Order (Phân tách bằng dấu phẩy)
LLM_PROVIDER_PRIORITY=gemini,openai,anthropic,groq
EMBEDDING_PROVIDER_PRIORITY=gemini,openai

# Embedding Configuration
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Observability (Tùy chọn)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=multi-agent-research-system

# Rate Limiting & Concurrency Guardrails
MAX_CONCURRENT_TASKS_PER_USER=2
DEFAULT_BUDGET_USD=2.00
DEFAULT_MAX_LLM_CALLS=40
